---
import MainLayout from "@/layouts/MainLayout.astro";
import { siteConfig } from "@/data/site";
---

<MainLayout
  title="Contact | Connor Pink"
  description="How to reach Connor Pink about research or software work."
>
  <section class="shell pt-14 sm:pt-20">
    <div class="margin-row">
      <div></div>
      <div class="max-w-[38rem]">
        <h1 class="text-[2.4rem]">Contact</h1>
        <p class="mt-4">Email is the best way to reach me, about research or software work.</p>
        <p class="mt-8 text-[1.6rem] sm:text-[2rem]">
          <a class="link" href={`mailto:${siteConfig.email}`}>{siteConfig.email}</a>
        </p>
        <dl class="meta mt-10 grid grid-cols-[6rem_1fr] gap-x-4 gap-y-2 !text-[0.8rem]">
          {
            siteConfig.socialLinks
              .filter((l) => !l.href.startsWith("mailto:"))
              .map((l) => (
                <>
                  <dt>{l.label.toLowerCase()}</dt>
                  <dd>
                    <a class="link" href={l.href} target="_blank" rel="noreferrer">
                      {l.href.replace(/^https:\/\/(www\.)?/, "").replace(/\/$/, "")}
                    </a>
                  </dd>
                </>
              ))
          }
          <dt>based in</dt>
          <dd class="text-[var(--color-body)]">{siteConfig.location}</dd>
        </dl>
      </div>
    </div>
  </section>
</MainLayout>
