---
import { getCollection, render } from "astro:content";
import EntryLayout from "@/layouts/EntryLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<EntryLayout
  title={project.data.title}
  section={{ label: "Projects", href: "/projects" }}
  summary={project.data.summary}
  pageImage={project.data.pageImage}
  links={project.data.links}
  meta={[
    { label: "Year", value: project.data.year },
    { label: "Role", value: project.data.role },
    { label: "Status", value: project.data.status },
    { label: "Stack", value: project.data.stack.join(", ") },
  ]}
>
  <Content />
</EntryLayout>
