---
import { Image } from "astro:assets";
import MainLayout from "@/layouts/MainLayout.astro";
import { getProjects, getResearch } from "@/lib/content";
import { siteConfig } from "@/data/site";
import portraitImage from "@/assets/images/ConnorPink-1.jpeg";
import presentingImage from "@/assets/images/presenting_full.jpg";
import samplesGrid from "@/assets/images/paper_samples_grid.png";

const projects = (await getProjects()).filter((p) => p.data.featured).slice(0, 4);
const research = (await getResearch()).filter((r) => r.data.featured);
---

<MainLayout description={siteConfig.bio}>
  <section class="shell pt-14 sm:pt-20">
    <div class="grid items-start gap-10 md:grid-cols-[minmax(0,1fr)_11rem]">
      <div class="max-w-[38rem]">
        <h1 id="bio" class="text-[2.6rem] sm:text-[3.4rem]">Connor Pink</h1>
        <p class="lede mt-6">
          I&apos;m doing an M.Sc. in Computer Science at the University of
          Guelph, in Dr.&nbsp;Sykes&apos; AI and Healthcare Lab. Most of my
          research is on chest X-rays: segmenting lungs, generating synthetic
          scans, and testing whether those synthetic scans actually help a
          tuberculosis classifier.
        </p>
        <p class="mt-5">
          Before that I did two co-op terms building internal software, at
          Employment and Social Development Canada and at Peterborough Regional
          Health Centre.
        </p>
        <p class="meta mt-7 flex flex-wrap gap-x-4 gap-y-1">
          <span>{siteConfig.location}</span>
          <a class="link" href={`mailto:${siteConfig.email}`}>email</a>
          <a class="link" href="https://github.com/connorpink" target="_blank" rel="noreferrer">github</a>
          <a class="link" href="https://www.linkedin.com/in/connor-pink-65b029193/" target="_blank" rel="noreferrer">linkedin</a>
          <a class="link" href="/resume">résumé</a>
        </p>
      </div>
      <figure class="fig hidden md:block">
        <Image
          src={portraitImage}
          alt="Portrait of Connor Pink."
          widths={[240, 480]}
          sizes="11rem"
          class="aspect-[3/4] object-cover"
        />
      </figure>
    </div>
  </section>

  <section class="shell">
    <div class="section margin-row">
      <div class="margin-label">Now</div>
      <div>
        <h2 class="section-heading">Do synthetic X-rays help, or is it just more data?</h2>
        <p class="mt-4 max-w-[38rem]">
          My thesis looks at training a TB classifier on mixes of real and
          generated chest X-rays (from a WGAN-GP and a latent diffusion model),
          to separate two effects: new variety in the data versus simply having
          more images. Part of it became a short paper at Canadian AI 2026. The
          diffusion images look better, but neither generator beat just
          duplicating real images to the same count.
          <a class="link" href="https://proceedings.mlr.press/v318/pink26a.html" target="_blank" rel="noreferrer">Read the paper</a>
          or <a class="link" href="/research/generative-ai-medical-imaging">the project notes</a>.
        </p>
        <div class="mt-8 grid gap-6 lg:grid-cols-[minmax(0,1.6fr)_minmax(0,1fr)] lg:items-end">
          <figure class="fig">
            <Image
              src={samplesGrid}
              alt="Grid of real and synthetic chest X-rays, by source and class."
              widths={[640, 960, 1400]}
              sizes="(max-width: 1024px) 100vw, 34rem"
              class="p-3"
            />
            <figcaption>
              <b>Fig. 1.</b> Real chest X-rays next to WGAN and diffusion samples,
              for TB and normal cases.
            </figcaption>
          </figure>
          <figure class="fig">
            <Image
              src={presentingImage}
              alt="Connor Pink presenting research slides in a lecture hall."
              widths={[480, 800]}
              sizes="(max-width: 1024px) 100vw, 20rem"
              class="aspect-[4/3] object-cover object-[center_30%]"
            />
            <figcaption><b>Fig. 2.</b> Presenting the pipeline at my M.Sc. seminar.</figcaption>
          </figure>
        </div>
      </div>
    </div>
  </section>

  <section class="shell">
    <div class="section margin-row">
      <div class="margin-label">Research</div>
      <div>
        {
          research.map((entry) => (
            <article class="entry first:pt-0">
              <a href={`/research/${entry.slug}`} class="no-underline">
                <h3 class="entry-title">{entry.data.title}</h3>
              </a>
              <p class="mt-1.5 max-w-[38rem]">{entry.data.summary}</p>
              <p class="meta mt-2">
                {entry.data.year} · {entry.data.publication}
              </p>
            </article>
          ))
        }
        <a class="link meta" href="/research">All research →</a>
      </div>
    </div>
  </section>

  <section class="shell">
    <div class="section margin-row">
      <div class="margin-label">Projects</div>
      <div>
        <div class="grid gap-x-8 gap-y-10 sm:grid-cols-2">
          {
            projects.map((project) => (
              <a href={`/projects/${project.slug}`} class="group block no-underline">
                {project.data.cardImage && (
                  <figure class="fig">
                    <Image
                      src={project.data.cardImage}
                      alt=""
                      widths={[480, 800]}
                      sizes="(max-width: 640px) 100vw, 22rem"
                      class="aspect-[16/10] object-cover object-top transition-opacity group-hover:opacity-85"
                    />
                  </figure>
                )}
                <h3 class="entry-title mt-3 group-hover:text-[var(--color-accent)]">
                  {project.data.title}
                </h3>
                <p class="mt-1 text-[0.95rem]">{project.data.summary}</p>
                <p class="meta mt-2">
                  {project.data.year} · {project.data.stack.slice(0, 3).join(", ")}
                </p>
              </a>
            ))
          }
        </div>
        <a class="link meta mt-8 inline-block" href="/projects">All projects →</a>
      </div>
    </div>
  </section>
</MainLayout>
