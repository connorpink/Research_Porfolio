---
import MainLayout from "@/layouts/MainLayout.astro";
import { resumeData, siteConfig } from "@/data/site";
---

<MainLayout
  title="Resume | Connor Pink"
  description="Resume, experience, education, funding, and technical skills for Connor Pink."
>
  <section class="shell pt-14 sm:pt-20">
    <div class="margin-row">
      <div></div>
      <div class="max-w-[38rem]">
        <h1 class="text-[2.4rem]">Résumé</h1>
        <p class="mt-4">{resumeData.summary}</p>
        <p class="mt-6 flex flex-wrap gap-3">
          <a class="button-primary" href={siteConfig.resumeViewerUrl}>View PDF</a>
          <a class="button-secondary" href={siteConfig.resumePdfPath} download="connor-pink-resume.pdf">Download</a>
        </p>
      </div>
    </div>
  </section>

  <section class="shell">
    <div class="section">
      <h2 class="section-heading margin-row"><span class="hidden md:block"></span>Experience</h2>
      {
        resumeData.experience.map((item) => (
          <article class="entry margin-row">
            <div class="margin-label">{item.period}</div>
            <div class="max-w-[38rem]">
              <h3 class="entry-title">{item.title}</h3>
              <p class="meta mt-0.5 !text-[0.8rem]">{item.company}</p>
              <p class="mt-2 text-[0.95rem]">{item.description}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="section">
      <h2 class="section-heading margin-row"><span class="hidden md:block"></span>Education</h2>
      {
        resumeData.education.map((item) => (
          <article class="entry margin-row">
            <div class="margin-label">{item.period}</div>
            <div class="max-w-[38rem]">
              <h3 class="entry-title">{item.title}</h3>
              <p class="meta mt-0.5 !text-[0.8rem]">{item.institution}</p>
              <p class="mt-2 text-[0.95rem]">{item.description}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="section">
      <h2 class="section-heading margin-row"><span class="hidden md:block"></span>Awards and funding</h2>
      {
        resumeData.awards.map((item) => (
          <article class="entry margin-row">
            <div class="margin-label">{item.detail}</div>
            <div class="max-w-[38rem]">
              <h3 class="entry-title">{item.title}</h3>
              <p class="mt-1 text-[0.95rem]">{item.note}</p>
            </div>
          </article>
        ))
      }
    </div>

    <div class="section margin-row">
      <h2 class="section-heading">Skills</h2>
      <p class="max-w-[38rem] pt-1">{resumeData.skills.join(", ")}.</p>
    </div>
  </section>
</MainLayout>
