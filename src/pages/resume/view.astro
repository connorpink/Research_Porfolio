---
import MainLayout from "@/layouts/MainLayout.astro";
import { siteConfig } from "@/data/site";
---

<MainLayout title="Résumé PDF | Connor Pink">
  <section class="shell pt-10 sm:pt-14">
    <div class="flex flex-wrap items-baseline justify-between gap-4">
      <p class="meta"><a class="link" href="/resume">← Résumé</a></p>
      <p class="flex flex-wrap gap-3">
        <a class="button-secondary" href={siteConfig.resumePdfPath} target="_blank" rel="noreferrer">Open in new tab ↗</a>
        <a class="button-primary" href={siteConfig.resumePdfPath} download="connor-pink-resume.pdf">Download</a>
      </p>
    </div>
    <iframe
      src={siteConfig.resumePdfPath}
      title="Connor Pink résumé PDF"
      class="mt-6 h-[80vh] w-full border bg-white"
      style="border-color: var(--color-line);"></iframe>
  </section>
</MainLayout>
