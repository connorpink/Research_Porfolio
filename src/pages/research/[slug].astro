---
import { getCollection, render } from "astro:content";
import EntryLayout from "@/layouts/EntryLayout.astro";

export async function getStaticPaths() {
  const research = await getCollection("research");
  return research.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
---

<EntryLayout
  title={entry.data.title}
  section={{ label: "Research", href: "/research" }}
  summary={entry.data.summary}
  pageImage={entry.data.pageImage}
  links={entry.data.links}
  meta={[
    { label: "Year", value: entry.data.year },
    { label: "Area", value: entry.data.domain },
    { label: "Where", value: entry.data.publication },
    { label: "Keywords", value: entry.data.tags.join(", ") },
  ]}
>
  <Content />
</EntryLayout>
