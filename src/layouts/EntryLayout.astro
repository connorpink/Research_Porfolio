---
import { Image } from "astro:assets";
import MainLayout from "@/layouts/MainLayout.astro";

interface Props {
  title: string;
  section: { label: string; href: string };
  summary: string;
  meta: { label: string; value: string }[];
  pageImage?: ImageMetadata;
  links?: { live?: string; repo?: string; paper?: string };
}

const { title, section, summary, meta, pageImage, links } = Astro.props;
---

<MainLayout
  title={`${title} | Connor Pink`}
  description={summary}
  image={pageImage?.src}
  imageAlt={title}
  imageWidth={pageImage?.width}
  imageHeight={pageImage?.height}
  type="article"
>
  <article class="shell pt-10 sm:pt-14">
    <div class="margin-row">
      <div class="margin-label">
        <a class="link" href={section.href}>← {section.label}</a>
      </div>
      <header class="max-w-[40rem]">
        <h1 class="text-[2.2rem] sm:text-[2.8rem]">{title}</h1>
        <p class="lede mt-4">{summary}</p>
        <dl class="meta mt-6 grid grid-cols-[6rem_1fr] gap-x-4 gap-y-1">
          {meta.map((item) => (
            <>
              <dt>{item.label.toLowerCase()}</dt>
              <dd class="text-[var(--color-body)]">{item.value}</dd>
            </>
          ))}
        </dl>
        {(links?.live || links?.repo || links?.paper) && (
          <p class="mt-6 flex flex-wrap gap-3">
            {links.paper && (
              <a class="button-primary" href={links.paper} target="_blank" rel="noreferrer">Read the paper ↗</a>
            )}
            {links.live && (
              <a class="button-primary" href={links.live} target="_blank" rel="noreferrer">Open live site ↗</a>
            )}
            {links.repo && (
              <a class="button-secondary" href={links.repo} target="_blank" rel="noreferrer">Source on GitHub ↗</a>
            )}
          </p>
        )}
      </header>
    </div>

    {pageImage && (
      <div class="margin-row mt-12">
        <div></div>
        <figure class="fig">
          <Image
            src={pageImage}
            alt={`Screenshot or figure from ${title}.`}
            widths={[640, 960, 1280, 1600]}
            sizes="(max-width: 1024px) 100vw, 52rem"
            class="max-h-[40rem] object-contain"
          />
        </figure>
      </div>
    )}

    <div class="margin-row mt-4">
      <div></div>
      <div class="prose-case">
        <slot />
      </div>
    </div>
  </article>
</MainLayout>
